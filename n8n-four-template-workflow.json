    {
      "id": "c4bfcd73-f4b7-44b8-8979-b6b9fefbc737",
      "name": "Prepare eligible outreach",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3820,
        -120
      ],
      "parameters": {
        "jsCode": "const d=$('Validate live deployment').last().json;const cfg=$('PicPulse settings').first().json;\nif(!/^https:\\/\\/[a-z0-9.-]+\\.netlify\\.app\\/?$/i.test(d.siteUrl))throw new Error('Missing verified HTTPS site URL; outreach blocked.');\nconst bundle=$('Package personalized company pages').first().json;\nconst escapeHtml=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nreturn bundle.leads.filter(l=>l.email_verified&&!l.opt_out).slice(0,cfg.maxEmailsPerRun).map(l=>{\n const siteUrl=d.siteUrl.replace(/\\/$/,'')+l.pagePath;\n const subject='PicPulse website concept for '+l.name+' ['+l.id+']';\n const message=`<p>Hello ${escapeHtml(l.name)} team,</p><p>I'm Theviru from PicPulse. We prepared an independent sample website design for your business.</p><p><a href=\"${siteUrl}\">View your website concept</a></p><p>This is an unofficial proposal using AI concept imagery and sample content. We would replace these with your approved details.</p><p>Our Basic package is <strong>LKR ${cfg.setupPriceLKR.toLocaleString()} setup</strong>, with <strong>LKR ${cfg.quarterlyPriceLKR.toLocaleString()} maintenance every three months</strong>. The first three months are included. The website includes a mobile layout, services or menu, gallery, contact links and directions. Custom domain registration and paid third-party services are extra. Booking and larger packages can be quoted separately.</p><p>Reply if you like the direction. No obligation. If you prefer no further contact, reply \u201cno thanks\u201d and we will stop.</p><p>Theviru<br>PicPulse</p>`;\n return {json:{id:l.id,name:l.name,email:l.email,siteUrl,subject,message,sendEnabled:cfg.sendEmails===true&&cfg.gmailConnected===true&&cfg.publicLinksVerified===true}};\n});"
      }
    },
