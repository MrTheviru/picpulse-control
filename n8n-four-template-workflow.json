      "name": "Select eligible business records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        100
      ],
      "parameters": {
        "jsCode": "const cfg=$('PicPulse settings').first().json;\nconst rows=$input.first().json.leads||[];\nreturn rows.filter(r=>!r.data.official_website_url&&!r.data.opt_out&&(r.website_status!=='published'||r.data.needs_rebuild)).slice(0,cfg.maxWebsitesPerRun).map(r=>({json:{...r.data,id:r.id,name:r.data.business_name||r.data.name,email:r.data.business_email||'',email_verified:r.data.email_verified===true,template:r.template,pagePath:'/prospects/'+r.id+'.html'}}));"
      }
    },
    {
      "id": "f4de8176-e6f2-4bb7-961c-9b926b770227",
      "name": "Package personalized company pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        100
      ],
      "parameters": {
        "jsCode": "const binary={};const results=$input.all();const leads=$('Select eligible business records').all().map(x=>x.json);let n=0;\nfor(const r of results){const d=r.json;if(!d.html||!d.id)throw Error('Template service did not return a company page');binary['file'+n++]={data:Buffer.from(d.html).toString('base64'),fileName:'prospects/'+d.id+'.html',mimeType:'text/html',fileExtension:'html'};}\nif(!n)throw Error('No company pages returned');\nreturn [{json:{cfg:$('PicPulse settings').first().json,leads,binaryFields:Object.keys(binary).join(','),websiteCount:n},binary}];"
      }
    },
