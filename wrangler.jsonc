{
  "name": "picpulse-control",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "picpulse-control",
      "database_id": "c084cced-145b-4ea6-ac06-8e121e8e4dd5"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "N8N_WEBSITE_WORKFLOW_URL": "https://picpulse.app.n8n.cloud/workflow/KTpOcGMDOulqSvLo",
    "N8N_REPLY_WORKFLOW_URL": "https://picpulse.app.n8n.cloud/workflow/QfpgwEsQYR1rpbxW",
    "N8N_RUN_URL": "https://picpulse.app.n8n.cloud/webhook/picpulse-nightly-upload",
    "AUTOMATIC_SENDING_ENABLED": "1"
  }
}
